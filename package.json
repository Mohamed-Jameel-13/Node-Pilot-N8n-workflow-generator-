{
  "name": "node-pilot-n8n-workflow-generator",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "node scripts/build-frontend-for-pages.mjs",
    "pages:build": "rm -rf node_modules package-lock.json frontend/node_modules && cd frontend && npm install --legacy-peer-deps && npx @cloudflare/next-on-pages@1.13.16"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.13.16",
    "@cloudflare/workers-types": "4.20241106.0",
    "wrangler": "3.90.0"
  },
  "overrides": {
    "wrangler": "3.90.0",
    "@cloudflare/workers-types": "4.20241106.0",
    "@cloudflare/next-on-pages": {
      "wrangler": "3.90.0",
      "@cloudflare/workers-types": "4.20241106.0"
    }
  }
}