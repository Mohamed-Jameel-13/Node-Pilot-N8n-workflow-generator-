{
  "name": "AI-Powered Lead Nurturing & CRM Sync",
  "description": "Captures leads from a webhook, enriches them via Clearbit, scores via OpenAI, routes by score tier, and syncs to HubSpot CRM with Slack notifications.",
  "nodes": [
    { "id": "webhook_trigger", "label": "Webhook Trigger", "parameters": { "httpMethod": "POST", "path": "/lead-capture" } },
    { "id": "validate_input", "label": "Code: Validate Input", "parameters": { "mode": "jsCode" } },
    { "id": "check_duplicate", "label": "HTTP: Check HubSpot Duplicate", "parameters": { "url": "https://api.hubapi.com/crm/v3/objects/contacts/search", "method": "POST" } },
    { "id": "if_duplicate", "label": "IF: Is Duplicate Contact?", "parameters": { "condition": "{{ $json.total > 0 }}" } },
    { "id": "update_existing", "label": "HTTP: Update Existing HubSpot Contact", "parameters": { "method": "PATCH" } },
    { "id": "enrich_with_clearbit", "label": "HTTP: Enrich Lead via Clearbit", "parameters": { "url": "https://person.clearbit.com/v2/combined/find", "method": "GET" } },
    { "id": "openai_lead_score", "label": "OpenAI: AI Lead Scoring", "parameters": { "model": "gpt-4o", "systemPrompt": "You are a B2B lead scoring expert. Score leads 1-100 based on company size, industry, and job title. Return JSON: { score, reasoning, tier }" } },
    { "id": "parse_score", "label": "Code: Parse AI Score Response", "parameters": { "mode": "jsCode" } },
    { "id": "switch_by_tier", "label": "Switch: Route by Lead Tier (Hot/Warm/Cold)", "parameters": { "rules": [{ "value": "hot" }, { "value": "warm" }, { "value": "cold" }] } },
    { "id": "hot_sequence_email", "label": "SendGrid: Send Hot Lead Email", "parameters": { "templateId": "d-hot-lead-template" } },
    { "id": "hot_slack_alert", "label": "Slack: Alert Sales Team - Hot Lead", "parameters": { "channel": "#hot-leads" } },
    { "id": "warm_sequence_email", "label": "SendGrid: Send Warm Lead Email", "parameters": { "templateId": "d-warm-lead-template" } },
    { "id": "warm_add_drip", "label": "HTTP: Add to ConvertKit Drip Sequence", "parameters": { "url": "https://api.convertkit.com/v3/sequences/subscribe", "method": "POST" } },
    { "id": "cold_sequence_email", "label": "SendGrid: Send Cold Lead Email", "parameters": { "templateId": "d-cold-lead-template" } },
    { "id": "create_hubspot_contact", "label": "HTTP: Create HubSpot Contact", "parameters": { "url": "https://api.hubapi.com/crm/v3/objects/contacts", "method": "POST" } },
    { "id": "create_hubspot_deal", "label": "HTTP: Create HubSpot Deal", "parameters": { "url": "https://api.hubapi.com/crm/v3/objects/deals", "method": "POST" } },
    { "id": "associate_deal", "label": "HTTP: Associate Deal to Contact in HubSpot", "parameters": { "url": "https://api.hubapi.com/crm/v3/associations/contacts/deals/batch/create", "method": "POST" } },
    { "id": "log_to_sheets", "label": "Google Sheets: Log Lead to CRM Sheet", "parameters": { "operation": "appendRow" } },
    { "id": "send_confirm_email", "label": "SendGrid: Confirm Receipt to Lead", "parameters": { "templateId": "d-confirm-template" } },
    { "id": "webhook_response", "label": "Respond to Webhook - Success", "parameters": { "statusCode": 200 } }
  ],
  "connections": [
    { "source": "webhook_trigger", "target": "validate_input" },
    { "source": "validate_input", "target": "check_duplicate" },
    { "source": "check_duplicate", "target": "if_duplicate" },
    { "source": "if_duplicate", "target": "update_existing" },
    { "source": "if_duplicate", "target": "enrich_with_clearbit" },
    { "source": "enrich_with_clearbit", "target": "openai_lead_score" },
    { "source": "openai_lead_score", "target": "parse_score" },
    { "source": "parse_score", "target": "switch_by_tier" },
    { "source": "switch_by_tier", "target": "hot_sequence_email" },
    { "source": "switch_by_tier", "target": "warm_sequence_email" },
    { "source": "switch_by_tier", "target": "cold_sequence_email" },
    { "source": "hot_sequence_email", "target": "hot_slack_alert" },
    { "source": "hot_slack_alert", "target": "create_hubspot_contact" },
    { "source": "warm_sequence_email", "target": "warm_add_drip" },
    { "source": "warm_add_drip", "target": "create_hubspot_contact" },
    { "source": "cold_sequence_email", "target": "create_hubspot_contact" },
    { "source": "create_hubspot_contact", "target": "create_hubspot_deal" },
    { "source": "create_hubspot_deal", "target": "associate_deal" },
    { "source": "associate_deal", "target": "log_to_sheets" },
    { "source": "log_to_sheets", "target": "send_confirm_email" },
    { "source": "send_confirm_email", "target": "webhook_response" }
  ]
}